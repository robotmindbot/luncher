{
  "expo": {
    "name": "luncher",
    "slug": "luncher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luncher",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "autolinking": {
      "android": {
        "buildFromSource": [".*"]
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.robotmind.luncher"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_CALENDAR"
      ],
      "versionCode": 1,
      "package": "io.robotmind.luncher"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/android-launcher-plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bento.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/bento.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
